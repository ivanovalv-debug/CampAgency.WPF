<UserControl x:Class="CampAgency.WPF.Views.Parent.ChildShiftJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock FontSize="20" FontWeight="Bold" Margin="0,0,0,10">
            <Run Text="Дневник смены: "/>
            <Run Text="{Binding Child.FullName}" FontWeight="Normal"/>
        </TextBlock>

        <DataGrid Grid.Row="1" ItemsSource="{Binding JournalEntries}" AutoGenerateColumns="False" 
                  CanUserAddRows="False" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Лагерь / Смена" Width="200">
                    <DataGridTextColumn.Binding>
                        <MultiBinding StringFormat="{}{0} ({1:dd.MM.yyyy})">
                            <Binding Path="Shift.Camp.CampName"/>
                            <Binding Path="Shift.StartDate"/>
                        </MultiBinding>
                    </DataGridTextColumn.Binding>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Дата и время" Binding="{Binding TimeStamp, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Событие" Binding="{Binding CampEvent.EventName}" Width="150"/>
                <DataGridTextColumn Header="Запись" Binding="{Binding Note}" Width="*"/>
                <DataGridTextColumn Header="Оператор" Binding="{Binding Operator.FullName}" Width="150"/>
            </DataGrid.Columns>
        </DataGrid>

        <Button Grid.Row="2" Content="← Назад" Command="{Binding BackToChildrenCommand}" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </Grid>
</UserControl>