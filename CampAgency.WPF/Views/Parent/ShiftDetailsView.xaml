<UserControl x:Class="CampAgency.WPF.Views.Parent.ShiftDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="20" Width="600">
        <TextBlock Text="Детали смены" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock FontWeight="Bold" Text="{Binding Shift.Camp.CampName}" FontSize="16"/>
                <TextBlock Text="{Binding Shift.Camp.CampType.CampTypeName}" FontWeight="Light"/>
                <TextBlock Text="{Binding Shift.Camp.Region.RegionName}"/>
                <TextBlock Margin="0,10,0,0">
                    <Run Text="Рейтинг:" FontWeight="Bold"/>
                    <Run Text="{Binding AverageRating, StringFormat=N1}"/>
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Даты:" FontWeight="Bold"/>
                    <Run Text="{Binding Shift.StartDate, StringFormat=dd.MM.yyyy}"/>
                    <Run Text=" - "/>
                    <Run Text="{Binding Shift.EndDate, StringFormat=dd.MM.yyyy}"/>
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Цена за одного ребёнка:" FontWeight="Bold"/>
                    <Run Text="{Binding Shift.Price, StringFormat=C}" Foreground="Green"/>
                </TextBlock>
                <TextBlock Margin="0,5,0,0">
                    <Run Text="Свободно мест:" FontWeight="Bold"/>
                    <Run Text="{Binding Shift.AvailableSeats}"/>
                </TextBlock>
                <TextBlock Margin="0,10,0,0">
                    <Run Text="Описание лагеря:" FontWeight="Bold"/>
                </TextBlock>
                <TextBlock Text="{Binding Shift.Camp.Description}" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Выберите детей для бронирования:" Margin="0,0,0,5"/>
        <ListBox ItemsSource="{Binding Children}" Margin="0,0,0,20" Height="150">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Child.FullName}" Margin="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border BorderBrush="LightGray" BorderThickness="1" Padding="10" Margin="0,0,0,20">
            <TextBlock>
                <Run Text="Итоговая стоимость:" FontWeight="Bold"/>
                <Run Text="{Binding TotalPrice, StringFormat=C}" Foreground="Red" FontWeight="Bold"/>
            </TextBlock>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Забронировать" Command="{Binding BookShiftCommand}" Width="120" Height="35" Margin="5" IsEnabled="{Binding IsBookingInProgress, Converter={StaticResource InverseBooleanConverter}}"/>
            <Button Content="Назад" Command="{Binding CancelCommand}" Width="100" Height="35" Margin="5"/>
        </StackPanel>
    </StackPanel>
</UserControl>