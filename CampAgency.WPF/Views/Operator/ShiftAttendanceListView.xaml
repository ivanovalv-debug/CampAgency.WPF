<UserControl x:Class="CampAgency.WPF.Views.Operator.ShiftAttendanceListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Списки заезда / выезда" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Выбор смены -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Смена:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" Width="350" Height="30">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Camp.CampName}" FontWeight="Bold"/>
                            <TextBlock FontSize="10">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:dd.MM.yyyy} - {1:dd.MM.yyyy}">
                                        <Binding Path="StartDate" />
                                        <Binding Path="EndDate" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>

                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Заехавшие -->
        <GroupBox Grid.Row="2" Header="Заехавшие дети" Margin="0,5">
            <StackPanel>
                <DataGrid ItemsSource="{Binding ArrivedChildren}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО ребёнка" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Родитель" Binding="{Binding User.FullName}" Width="150"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding User.Phone}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="📋 Копировать список заехавших" Command="{Binding CopyArrivedListCommand}" Width="200" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </GroupBox>

        <!-- Выехавшие -->
        <GroupBox Grid.Row="3" Header="Выехавшие дети" Margin="0,5">
            <StackPanel>
                <DataGrid ItemsSource="{Binding DepartedChildren}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" MaxHeight="200">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО ребёнка" Binding="{Binding FullName}" Width="*"/>
                        <DataGridTextColumn Header="Родитель" Binding="{Binding User.FullName}" Width="150"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding User.Phone}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="📋 Копировать список выехавших" Command="{Binding CopyDepartedListCommand}" Width="200" Height="30" Margin="0,10,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </GroupBox>

        <Button Grid.Row="4" Content="← Назад" Command="{Binding BackToDashboardCommand}" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </Grid>
</UserControl>