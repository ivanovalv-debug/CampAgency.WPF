<UserControl x:Class="CampAgency.WPF.Views.Operator.ShiftJournalView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Дневник смены" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- Выбор смены -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Смена:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox ItemsSource="{Binding Shifts}" SelectedItem="{Binding SelectedShift}" Width="300" Height="30">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Camp.CampName}" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StartDate, StringFormat=dd.MM.yyyy}" FontSize="10"/>
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- Добавление записи -->
        <GroupBox Grid.Row="2" Header="Добавить запись" Margin="0,0,0,10">
            <StackPanel Margin="10">
                <TextBlock Text="Ребёнок:"/>
                <ComboBox ItemsSource="{Binding Children}" SelectedItem="{Binding SelectedChild}" DisplayMemberPath="FullName" Margin="0,5" Height="30"/>
                <TextBlock Text="Тип события:" Margin="0,10,0,0"/>
                <ComboBox ItemsSource="{Binding Events}" SelectedItem="{Binding SelectedEvent}" DisplayMemberPath="EventName" Margin="0,5" Height="30"/>
                <TextBlock Text="Текст записи:" Margin="0,10,0,0"/>
                <TextBox Text="{Binding Note}" TextWrapping="Wrap" Height="80" AcceptsReturn="True" Margin="0,5"/>
                <Button Content="Добавить" Command="{Binding AddEntryCommand}" Width="120" Height="35" Margin="0,10,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
        </GroupBox>

        <!-- Список записей -->
        <GroupBox Grid.Row="3" Header="История записей">
            <DataGrid ItemsSource="{Binding JournalEntries}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding TimeStamp, StringFormat=dd.MM.yyyy HH:mm}" Width="120"/>
                    <DataGridTextColumn Header="Ребёнок" Binding="{Binding Child.FullName}" Width="150"/>
                    <DataGridTextColumn Header="Событие" Binding="{Binding CampEvent.EventName}" Width="150"/>
                    <DataGridTextColumn Header="Запись" Binding="{Binding Note}" Width="*"/>
                    <DataGridTextColumn Header="Оператор" Binding="{Binding Operator.FullName}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <Button Grid.Row="4" Content="← Назад" Command="{Binding BackToDashboardCommand}" Width="120" Height="30" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </Grid>
</UserControl>